{
  "name": "fast-ros-and-pe-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline PE Note with a parity-protected TypeScript and React v2 track.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:v2": "vite build --config vite.config.ts",
    "build:all": "npm run build && npm run build:v2",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:clinical-catalog": "node scripts/check-clinical-catalog.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:legacy": "node scripts/check-legacy-baseline.mjs",
    "check:syntax": "node --check src/legacy/app.js && node --check config/assets.mjs",
    "check:v2-artifact": "node scripts/check-v2-artifact.mjs",
    "check:v2-boundaries": "node scripts/check-v2-boundaries.mjs",
    "sync:clinical-catalog": "node scripts/sync-clinical-catalog.mjs",
    "accept:legacy": "node scripts/update-legacy-baseline.mjs",
    "dev:v2": "vite --config vite.config.ts --host 127.0.0.1 --port 4174",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview:v2": "vite preview --config vite.config.ts --host 127.0.0.1 --port 4174",
    "start": "node scripts/serve.mjs",
    "test": "npm run test:legacy && npm run test:unit",
    "test:e2e": "playwright test",
    "test:legacy": "node --test --test-isolation=none tests/app.smoke.test.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:generated && npm run check:legacy && npm run check:clinical-catalog && npm run check:architecture && npm run check:v2-boundaries && npm run check:syntax && npm run typecheck && npm run lint && npm run format:check && npm run build:v2 && npm run check:v2-artifact && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  }
}
